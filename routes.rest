@baseUrl = http://localhost:3000

### Create a valid meeting
# @name createMeeting
POST {{baseUrl}}/api/meetings
Content-Type: application/json

{
  "date": "2027-10-04",
  "meetingType": "regular",
  "presiding": "Bishop Smith",
  "conducting": "Brother Jones",
  "announcements": ["Ward temple trip next month"],
  "openingHymn": { "number": 19, "title": "We Thank Thee, O God, for a Prophet" },
  "openingPrayer": "Sister Adams",
  "wardBusiness": [],
  "stakeBusiness": false,
  "sacramentHymn": { "number": 169, "title": "As Now We Take the Sacrament" },
  "speakers": [
    { "name": "Brother Lee", "topic": "Faith", "type": "speaker" }
  ],
  "closingHymn": { "number": 301, "title": "Love at Home" },
  "closingPrayer": "Brother Kim"
}

### Expect 400 — missing required fields
POST {{baseUrl}}/api/meetings
Content-Type: application/json

{
  "date": "2027-10-11"
}

